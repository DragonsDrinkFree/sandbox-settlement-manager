<div class="city-resources-content">
  {{#if hasDiscovered}}
  <ul class="resource-flat-list">
    {{#each resources}}
    <li class="resource-entry" data-resource-id="{{this.id}}">
      <span class="resource-name">{{this.name}}</span>
      <div class="resource-type-badges">
        {{#each this.types}}
        <i class="{{this.icon}} resource-type-badge" title="{{this.name}}" inert></i>
        {{/each}}
      </div>
    </li>
    {{/each}}
  </ul>
  {{else}}
    <p class="notification info">{{localize "SANDBOX_SETTLEMENT_MANAGER.resources.noneDiscovered"}}</p>
  {{/if}}
</div>
