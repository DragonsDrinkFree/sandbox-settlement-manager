<div class="currency-payment-dialog-content">
  <header class="purchase-header">
    <span class="purchase-cost">{{expenseCostLabel}}</span>
  </header>

  {{#if showBalance}}
  <div class="balance-display">
    <h4>{{localize "SANDBOX_SETTLEMENT_MANAGER.purchase.balanceHeader"}}</h4>
    <ul class="balance-list">
      {{#each currencies}}
      <li>
        <span class="balance-currency">{{this.name}}</span>
        <span class="balance-amount">{{lookup ../balance this.id}}</span>
        <span class="balance-abbr">{{this.abbreviation}}</span>
      </li>
      {{/each}}
    </ul>
  </div>
  {{/if}}

  <div class="payment-section">
    <h4>{{localize "SANDBOX_SETTLEMENT_MANAGER.purchase.paymentHeader"}}</h4>
    <ul class="payment-inputs">
      {{#each currencies}}
      <li class="payment-row">
        <label>{{this.name}} <em>({{this.abbreviation}})</em></label>
        <input type="number" class="payment-input" name="payment-{{this.id}}"
               data-currency-id="{{this.id}}" min="0" value="0">
        <button type="button" class="fill-button" data-action="fillCurrency"
                data-currency-id="{{this.id}}"
                {{#if this.fillDisabled}}disabled{{/if}}
                data-tooltip="{{localize 'SANDBOX_SETTLEMENT_MANAGER.purchase.fillTooltip'}}">+</button>
      </li>
      {{/each}}
    </ul>
  </div>

  <div class="calc-section">
    <div class="calc-row">
      <span>{{localize "SANDBOX_SETTLEMENT_MANAGER.purchase.cost"}}: <strong>{{expenseCostLabel}}</strong></span>
      <span>{{localize "SANDBOX_SETTLEMENT_MANAGER.purchase.remaining"}}: <strong class="calc-remaining">—</strong></span>
    </div>
    <div class="calc-row">
      <span>{{localize "SANDBOX_SETTLEMENT_MANAGER.purchase.offering"}}: <strong class="calc-offering">—</strong></span>
      <span>{{localize "SANDBOX_SETTLEMENT_MANAGER.purchase.change"}}: <strong class="calc-change">—</strong></span>
    </div>
  </div>

  <p class="purchase-error"></p>

  <div class="purchase-actions">
    <button type="submit" disabled>{{submitLabel}}</button>
  </div>
</div>
