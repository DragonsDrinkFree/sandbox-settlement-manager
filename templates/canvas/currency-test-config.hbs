<div class="currency-test-config-content">
  <ul class="expense-list">
    {{#each expenses}}
    <li class="expense-item" data-expense-id="{{this.id}}">
      <div class="expense-info">
        <span class="expense-name">{{this.name}}</span>
        <span class="expense-cost">{{this.currencyLabel}}</span>
      </div>
      <div class="controls">
        <button type="button" class="icon" data-action="deleteExpense"
                aria-label="{{localize 'SANDBOX_CITY_MANAGER.currencyTest.deleteExpense'}}">
          <i class="fa-solid fa-trash"></i>
        </button>
      </div>
    </li>
    {{else}}
    <li class="expense-empty"><em>{{localize "SANDBOX_CITY_MANAGER.currencyTest.noExpenses"}}</em></li>
    {{/each}}
  </ul>

  <div class="add-expense-form">
    <input type="text" name="newExpenseName"
           placeholder="{{localize 'SANDBOX_CITY_MANAGER.currencyTest.expenseNamePlaceholder'}}">
    <select name="newExpenseCurrency">
      {{#each currencies}}
      <option value="{{this.value}}">{{this.label}}</option>
      {{/each}}
    </select>
    <input type="number" name="newExpenseAmount" min="0.01" step="any" placeholder="1" style="width:5rem">
    <button type="button" data-action="addExpense">
      <i class="fa-solid fa-plus"></i> {{localize "SANDBOX_CITY_MANAGER.currencyTest.addExpense"}}
    </button>
  </div>
</div>
