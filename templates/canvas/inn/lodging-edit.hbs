<div class="lodging-edit-form">
  <div class="lodging-compact-row">
    <div class="lodging-compact-name">
      <label>{{localize "SANDBOX_SETTLEMENT_MANAGER.inn.lodging.name"}}</label>
      <input type="text" name="name" value="{{lodging.name}}" placeholder="e.g. Common Room">
    </div>
    <div class="lodging-compact-beds">
      <label>{{localize "SANDBOX_SETTLEMENT_MANAGER.inn.lodging.beds"}}</label>
      <input type="number" name="beds" value="{{lodging.beds}}" min="0" step="1">
    </div>
    <div class="lodging-compact-beds">
      <label title="{{localize 'SANDBOX_SETTLEMENT_MANAGER.inn.lodging.availabilityHint'}}">{{localize "SANDBOX_SETTLEMENT_MANAGER.inn.lodging.availability"}}</label>
      <input type="number" name="availability" value="{{lodging.availability}}" min="1" step="1" placeholder="∞"
             title="{{localize 'SANDBOX_SETTLEMENT_MANAGER.inn.lodging.availabilityHint'}}">
    </div>
    <div class="lodging-compact-price">
      <label>{{localize "SANDBOX_SETTLEMENT_MANAGER.inn.lodging.pricePerDay"}}</label>
      <div class="price-field-row">
        {{> ssm-price-input attr="name" field="pricePerDay" price=lodging.pricePerDay currencies=currencies amountClass="price-amount-input" selectClass="price-currency-select"}}
      </div>
    </div>
  </div>
  <div class="lodging-week-row">
    <label class="lodging-check-row">
      <input type="checkbox" name="autoWeekly" {{#if autoWeekly}}checked{{/if}}>
      {{localize "SANDBOX_SETTLEMENT_MANAGER.inn.lodging.pricePerWeek"}}
      <em class="lodging-hint">{{localize "SANDBOX_SETTLEMENT_MANAGER.inn.lodging.autoWeekly"}}</em>
    </label>
    <div class="price-field-row price-per-week-fields">
      {{> ssm-price-input attr="name" field="pricePerWeek" price=lodging.pricePerWeek currencies=currencies amountClass="price-amount-input" selectClass="price-currency-select"}}
    </div>
  </div>
</div>
