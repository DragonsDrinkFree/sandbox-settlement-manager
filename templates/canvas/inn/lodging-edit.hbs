<div class="lodging-edit-form">
  <div class="form-group">
    <label>{{localize "SANDBOX_SETTLEMENT_MANAGER.inn.lodging.name"}}</label>
    <input type="text" name="name" value="{{lodging.name}}"
           placeholder="e.g. Common Room">
  </div>
  <div class="form-group">
    <label>{{localize "SANDBOX_SETTLEMENT_MANAGER.inn.lodging.beds"}}</label>
    <input type="number" name="beds" value="{{lodging.beds}}" min="1" step="1">
  </div>
  <div class="form-group">
    <label>{{localize "SANDBOX_SETTLEMENT_MANAGER.inn.lodging.infinite"}}</label>
    <input type="checkbox" name="infinite" {{#if lodging.infinite}}checked{{/if}}>
  </div>
  <div class="form-group">
    <label>{{localize "SANDBOX_SETTLEMENT_MANAGER.inn.lodging.pricePerDay"}}</label>
    <div class="price-field-row">
      <input type="number" name="pricePerDayAmount" value="{{lodging.pricePerDay.amount}}" min="0" step="0.01" class="price-amount-input">
      <select name="pricePerDayCurrencyId" class="price-currency-select">
        {{#each currencies}}
        <option value="{{this.id}}"{{#if (eq this.id ../lodging.pricePerDay.currencyId)}} selected{{/if}}>{{this.abbreviation}}</option>
        {{/each}}
      </select>
    </div>
  </div>
  <div class="form-group">
    <label>{{localize "SANDBOX_SETTLEMENT_MANAGER.inn.lodging.pricePerWeek"}}</label>
    <label class="checkbox-label">
      <input type="checkbox" name="autoWeekly" {{#if autoWeekly}}checked{{/if}}>
      {{localize "SANDBOX_SETTLEMENT_MANAGER.inn.lodging.autoWeekly"}}
    </label>
    <div class="price-field-row price-per-week-fields">
      <input type="number" name="pricePerWeekAmount" value="{{lodging.pricePerWeek.amount}}" min="0" step="0.01" class="price-amount-input">
      <select name="pricePerWeekCurrencyId" class="price-currency-select">
        {{#each currencies}}
        <option value="{{this.id}}"{{#if (eq this.id ../lodging.pricePerWeek.currencyId)}} selected{{/if}}>{{this.abbreviation}}</option>
        {{/each}}
      </select>
    </div>
  </div>
</div>
