<div class="lodging-rental-form">
  <div class="rental-lodging-header">
    <strong>{{lodging.name}}</strong>
    <span class="rental-beds">{{lodging.beds}} {{localize "SANDBOX_SETTLEMENT_MANAGER.inn.lodging.beds"}}</span>
  </div>
  <div class="form-group">
    <label>{{localize "SANDBOX_SETTLEMENT_MANAGER.inn.rental.actor"}}</label>
    <select name="actorId">
      {{#each ownedActors}}
      <option value="{{this.id}}"{{#if (eq this.id ../defaultActorId)}} selected{{/if}}>{{this.name}}</option>
      {{/each}}
    </select>
  </div>
  <div class="form-group">
    <label>{{localize "SANDBOX_SETTLEMENT_MANAGER.inn.rental.duration"}}</label>
    <div class="rental-duration-row">
      <input type="number" name="duration" value="1" min="1" step="1" class="rental-duration-input">
      <label class="inline-label">
        <input type="radio" name="unit" value="days" checked>
        {{localize "SANDBOX_SETTLEMENT_MANAGER.inn.rental.days"}}
      </label>
      <label class="inline-label">
        <input type="radio" name="unit" value="weeks">
        {{localize "SANDBOX_SETTLEMENT_MANAGER.inn.rental.weeks"}}
      </label>
    </div>
  </div>
  <div class="form-group">
    <label>{{localize "SANDBOX_SETTLEMENT_MANAGER.inn.rental.totalCost"}}</label>
    <span class="rental-cost-preview">—</span>
  </div>
</div>
