<div class="menu-item-edit-form">
  <div class="form-group">
    <label>{{localize "SANDBOX_SETTLEMENT_MANAGER.inn.menuItem.name"}}</label>
    <input type="text" name="name" value="{{item.name}}"
           placeholder="{{localize 'SANDBOX_SETTLEMENT_MANAGER.inn.menuItem.name'}}">
  </div>

  <div class="form-group">
    <label>{{localize "SANDBOX_SETTLEMENT_MANAGER.inn.menuItem.description"}}</label>
    <textarea name="description" rows="2">{{item.description}}</textarea>
  </div>

  <fieldset class="menu-item-linked-item">
    <legend>{{localize "SANDBOX_SETTLEMENT_MANAGER.inn.menuItem.linkedItem"}}</legend>
    <p class="hint">{{localize "SANDBOX_SETTLEMENT_MANAGER.inn.menuItem.linkedItemHint"}}</p>
    {{#if item.itemId}}
    <div class="linked-item-display">
      <i class="fa-solid fa-box"></i>
      <span class="linked-item-name">{{item.itemName}}</span>
      <button type="button" class="clear-linked-item icon" aria-label="{{localize 'SANDBOX_SETTLEMENT_MANAGER.inn.menuItem.clearLinkedItem'}}">
        <i class="fa-solid fa-times"></i>
      </button>
    </div>
    {{else}}
    <div class="item-drop-zone">
      <i class="fa-solid fa-arrow-down"></i>
      <span>{{localize "SANDBOX_SETTLEMENT_MANAGER.inn.menuItem.dropZoneLabel"}}</span>
    </div>
    {{/if}}
  </fieldset>

  <div class="form-group">
    <label>
      <input type="checkbox" name="hasPriceOverride" {{#if hasPriceOverride}}checked{{/if}}>
      {{localize "SANDBOX_SETTLEMENT_MANAGER.inn.menuItem.priceOverride"}}
    </label>
  </div>

  <div class="price-override-fields form-group">
    <label>{{localize "SANDBOX_SETTLEMENT_MANAGER.inn.menuItem.price"}}</label>
    <div class="price-fields-row">
      <select name="priceCurrencyId">
        {{#each currencies}}
        <option value="{{this.id}}"{{#if (eq this.id ../item.price.currencyId)}} selected{{/if}}>
          {{this.name}} ({{this.abbreviation}})
        </option>
        {{/each}}
      </select>
      <input type="number" name="priceAmount" value="{{item.price.amount}}" min="0" step="0.01">
    </div>
  </div>
</div>
