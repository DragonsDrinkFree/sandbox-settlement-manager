<div class="merchant-item-edit-form">
  <div class="form-group">
    <label>{{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.item.nameLabel"}}</label>
    <input type="text" name="name" value="{{item.name}}"
           placeholder="{{localize 'SANDBOX_SETTLEMENT_MANAGER.merchant.item.namePlaceholder'}}">
  </div>
  {{#if hasTypes}}
  <div class="form-group">
    <label>{{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.systemTypeLabel"}}</label>
    <select name="itemType">
      <option value="">— None —</option>
      {{#each typeOptions}}
      <option value="{{this.value}}"{{#if this.selected}} selected{{/if}}>{{this.label}}</option>
      {{/each}}
    </select>
  </div>
  {{/if}}
  <div class="form-group">
    <label>{{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.item.priceLabel"}}</label>
    <div class="price-row">
      <input type="number" name="priceAmount" value="{{item.price.amount}}" min="0" step="0.01"
             class="price-amount-input">
      <select name="priceCurrencyId" class="price-currency-select">
        {{#each currencies}}
        <option value="{{this.id}}"{{#if (eq this.id ../item.price.currencyId)}} selected{{/if}}>
          {{this.abbreviation}}
        </option>
        {{/each}}
      </select>
    </div>
  </div>
  {{#if hasCityTypes}}
  <div class="form-group">
    <label>{{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.settlementSize"}}</label>
    <select name="minCitySize">
      <option value=""{{#unless item.minCitySize}} selected{{/unless}}>{{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.settlementSizeAll"}}</option>
      {{#each cityTypes}}
      <option value="{{this.name}}"{{#if (eq this.name ../item.minCitySize)}} selected{{/if}}>{{this.name}}</option>
      {{/each}}
    </select>
  </div>
  {{/if}}
  <div class="form-group">
    <label>{{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.stockAvailability"}}</label>
    <input type="number" name="stockAvailability" value="{{item.stockAvailability}}" min="0" max="100" step="1">
  </div>
  <div class="form-group">
    <label>{{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.stockFormula"}}</label>
    <input type="text" name="stockFormula" value="{{item.stockFormula}}"
           placeholder="{{localize 'SANDBOX_SETTLEMENT_MANAGER.merchant.stockFormulaHint'}}">
  </div>
</div>
