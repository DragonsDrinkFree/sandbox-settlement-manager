<div class="purchasing-profile-edit-form">
  <p class="notification info">{{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.profileEditHint"}}</p>

  <table class="ssm-purchasing-profile-table ssm-table">
    <thead>
      <tr>
        <th>{{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.colItem"}}</th>
        <th class="col-num">{{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.buyRate"}}</th>
        <th>{{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.buybackType"}}</th>
        <th class="ssm-col-source"></th>
        <th class="col-del"></th>
      </tr>
    </thead>
    <tbody>
      {{#each displayRules}}
      <tr class="{{#if this._conflicted}}ssm-conflict-row{{/if}}">
        <td>{{this.itemTypeLabel}}</td>
        <td class="col-num ssm-col-right">{{this.buyRate}}%</td>
        <td>{{this.buybackLabel}}</td>
        <td>
          {{#if this._conflicted}}<span class="ssm-conflict-badge" title="{{localize 'SANDBOX_SETTLEMENT_MANAGER.merchant.conflictWarning'}}"><i class="fa-solid fa-triangle-exclamation"></i></span>{{/if}}
          {{#if this.isOverride}}<span class="ssm-override-badge">override</span>{{/if}}
        </td>
        <td class="col-del">
          <button type="button" class="icon" data-action="deleteRule"
                  data-item-type="{{this.itemType}}" aria-label="Disable rule">
            <i class="fa-solid fa-ban"></i>
          </button>
        </td>
      </tr>
      {{else}}
      <tr>
        <td colspan="5" class="lodging-table-empty">
          <em>{{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.noRules"}}</em>
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>

  <fieldset class="purchasing-add-override">
    <legend>{{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.addRule"}}</legend>
    <div class="purchasing-add-row">
      <select data-field="overrideItemType" class="ssm-rule-type-select">
        {{#each systemItemTypes}}
        <option value="{{this.value}}">{{this.label}}</option>
        {{/each}}
      </select>
      <label class="ssm-rule-rate-label"
             title="{{localize 'SANDBOX_SETTLEMENT_MANAGER.merchant.merchantPriceHint'}}">
        {{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.merchantPrice"}}
      </label>
      <input type="number" data-field="overrideBuyRate" value="50" min="0" max="100" step="1"
             class="lodging-num-input">
      <span>%</span>
      <select data-field="overrideBuybackType" class="ssm-rule-buyback-select">
        {{#each buybackTypeOptions}}
        <option value="{{this.value}}">{{this.label}}</option>
        {{/each}}
      </select>
      <button type="button" data-action="addOverride" class="lodging-add-btn">
        <i class="fa-solid fa-plus"></i> {{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.addRule"}}
      </button>
    </div>
  </fieldset>
</div>
