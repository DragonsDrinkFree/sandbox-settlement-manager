<div class="resource-detail-content">
  {{#if hasMultipleTabs}}
  <nav class="resource-detail-tabs">
    {{#each tabs}}
    <button type="button" class="resource-detail-tab{{#if this.active}} active{{/if}}"
            data-action="switchFromSellTab" data-tab-id="{{this.id}}">
      <i class="{{this.icon}}" inert></i> {{this.name}}
    </button>
    {{/each}}
    {{#if hasSellTab}}
    <button type="button" class="resource-detail-tab{{#if sellTabActive}} active{{/if}}"
            data-action="switchToSellTab">
      <i class="fa-solid fa-hand-holding-dollar" inert></i> {{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.sellItems"}}
    </button>
    {{/if}}
  </nav>
  {{/if}}
  {{#each tabs}}
  <div class="resource-detail-tab-pane{{#if this.active}} active{{/if}}">
    {{#if this.isInn}}
    <div class="inn-detail">

      <div class="inn-section">
        <div class="inn-section-header">
          <span class="inn-section-title">{{localize "SANDBOX_SETTLEMENT_MANAGER.inn.ledger"}}</span>
        </div>
        <table class="inn-ledger-table ssm-table">
          <thead>
            <tr>
              <th class="col-character">{{localize "SANDBOX_SETTLEMENT_MANAGER.inn.table.colCharacter"}}</th>
              <th class="col-lodging">{{localize "SANDBOX_SETTLEMENT_MANAGER.inn.table.colLodging"}}</th>
              <th class="col-beds ssm-col-right">{{localize "SANDBOX_SETTLEMENT_MANAGER.inn.table.colBeds"}}</th>
              <th class="col-time ssm-col-right">{{localize "SANDBOX_SETTLEMENT_MANAGER.inn.table.colTimeRemaining"}}</th>
              {{#if this.innData.isGM}}<th class="ssm-col-action"></th>{{/if}}
            </tr>
          </thead>
          <tbody>
            {{#each this.innData.ledger}}
            <tr class="inn-ledger-row{{#if this.isExpired}} expired{{/if}}">
              <td class="col-character">{{this.actorName}}</td>
              <td class="col-lodging">{{this.lodgingName}}</td>
              <td class="col-beds ssm-col-right">{{this.beds}}</td>
              <td class="col-time ssm-col-right">{{this.timeRemainingLabel}}</td>
              {{#if ../innData.isGM}}
              <td class="ssm-col-action">
                <button type="button" class="icon" data-action="dismissLedgerEntry" data-entry-id="{{this.id}}"
                        aria-label="Dismiss">
                  <i class="fa-solid fa-times"></i>
                </button>
              </td>
              {{/if}}
            </tr>
            {{else}}
            <tr>
              <td class="ssm-empty" colspan="5"><em>{{localize "SANDBOX_SETTLEMENT_MANAGER.inn.noBookings"}}</em></td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>

      <div class="inn-section">
        <div class="inn-section-header">
          <span class="inn-section-title">{{localize "SANDBOX_SETTLEMENT_MANAGER.inn.lodgingSection"}}</span>
          {{#if this.innData.isGM}}
          <button type="button" class="icon" data-action="addLodging"
                  aria-label="Add Lodging">
            <i class="fa-solid fa-plus"></i>
          </button>
          {{/if}}
        </div>
        <table class="inn-lodging-table ssm-table">
          <thead>
            <tr>
              {{#if this.innData.isGM}}<th class="ssm-col-controls"></th>{{/if}}
              <th class="col-name">{{localize "SANDBOX_SETTLEMENT_MANAGER.inn.table.colName"}}</th>
              <th class="col-beds ssm-col-right">{{localize "SANDBOX_SETTLEMENT_MANAGER.inn.table.colBeds"}}</th>
              {{#if this.innData.isGM}}<th class="col-avail ssm-col-right">{{localize "SANDBOX_SETTLEMENT_MANAGER.inn.table.colAvail"}}</th>{{/if}}
              <th class="col-day ssm-col-right">{{localize "SANDBOX_SETTLEMENT_MANAGER.inn.table.colDay"}}</th>
              <th class="col-week ssm-col-right">{{localize "SANDBOX_SETTLEMENT_MANAGER.inn.table.colWeek"}}</th>
              <th class="ssm-col-action"></th>
            </tr>
          </thead>
          <tbody>
            {{#each this.innData.lodgings}}
            <tr class="inn-lodging-row{{#if this.overridden}} is-overridden{{/if}}">
              {{#if ../innData.isGM}}
              <td class="ssm-col-controls">
                <button type="button" class="icon lodging-ctrl-btn" data-action="editLodging" data-lodging-id="{{this.id}}"
                        aria-label="{{localize 'SANDBOX_SETTLEMENT_MANAGER.resource.edit'}}">
                  <i class="fa-solid fa-pen-to-square"></i>
                </button>
                <button type="button" class="icon lodging-ctrl-btn" data-action="deleteLodging" data-lodging-id="{{this.id}}"
                        aria-label="{{localize 'SANDBOX_SETTLEMENT_MANAGER.resource.delete'}}">
                  <i class="fa-solid fa-trash"></i>
                </button>
              </td>
              {{/if}}
              <td class="col-name">{{this.name}}</td>
              <td class="col-beds ssm-col-right">{{this.beds}}</td>
              {{#if ../innData.isGM}}<td class="col-avail ssm-col-right">{{this.availabilityDisplay}}</td>{{/if}}
              <td class="col-day ssm-col-right">{{this.pricePerDayLabel}}</td>
              <td class="col-week ssm-col-right">{{this.pricePerWeekLabel}}</td>
              <td class="ssm-col-action">
                <button type="button" class="inn-rent-btn" data-action="rentLodging" data-lodging-id="{{this.id}}"
                        {{#if this.isSoldOut}}disabled{{/if}}>
                  {{localize "SANDBOX_SETTLEMENT_MANAGER.inn.rent"}}
                </button>
              </td>
            </tr>
            {{else}}
            <tr>
              <td class="ssm-empty" colspan="7"><em>{{localize "SANDBOX_SETTLEMENT_MANAGER.inn.noLodgings"}}</em></td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>

      <div class="inn-section inn-menu-section">
        <div class="inn-section-header">
          <span class="inn-section-title">{{localize "SANDBOX_SETTLEMENT_MANAGER.inn.menu.sectionTitle"}}</span>
          {{#if this.innData.isGM}}
          <button type="button" class="icon" data-action="configureMenu"
                  aria-label="{{localize 'SANDBOX_SETTLEMENT_MANAGER.inn.menu.configureTitle'}}">
            <i class="fa-solid fa-gear"></i>
          </button>
          {{/if}}
        </div>
        {{#if this.innData.menuData.hasCourses}}
        {{#each this.innData.menuData.courses}}
        <div class="inn-course-section{{#if this.overridden}} is-overridden{{/if}}" data-course-id="{{this.id}}">
          <div class="inn-course-header">
            <span class="inn-course-name">{{this.name}}</span>
            <span class="inn-course-mode-badge">{{#if this.isRandom}}{{localize "SANDBOX_SETTLEMENT_MANAGER.inn.course.modeRandom"}}{{else}}{{localize "SANDBOX_SETTLEMENT_MANAGER.inn.course.modeStatic"}}{{/if}}</span>
            {{#if this.isRandom}}{{#if ../innData.isGM}}
            <button type="button" class="icon" data-action="refreshCourse" data-course-id="{{this.id}}"
                    aria-label="Refresh"><i class="fa-solid fa-rotate"></i></button>
            {{/if}}{{/if}}
          </div>
          <table class="menu-item-table ssm-table">
            <thead>
              <tr>
                <th class="col-name">{{localize "SANDBOX_SETTLEMENT_MANAGER.inn.menu.colItem"}}</th>
                <th class="col-desc">{{localize "SANDBOX_SETTLEMENT_MANAGER.inn.menu.colDescription"}}</th>
                <th class="col-price ssm-col-right">{{localize "SANDBOX_SETTLEMENT_MANAGER.inn.menu.colPrice"}}</th>
                <th class="ssm-col-action"></th>
              </tr>
            </thead>
            <tbody>
              {{#each this.visibleItems}}
              <tr>
                <td class="col-name">{{this.name}}{{#if this.itemId}} <i class="fa-solid fa-box fa-xs menu-item-linked-badge" title="{{this.itemName}}"></i>{{/if}}</td>
                <td class="col-desc">{{this.description}}</td>
                <td class="col-price ssm-col-right">{{#if this.priceLabel}}{{this.priceLabel}}{{else}}<em>—</em>{{/if}}</td>
                <td class="ssm-col-action">
                  {{#if this.hasPrice}}
                  <button type="button" class="buy-button" data-action="buyMenuItem"
                          data-course-id="{{../id}}" data-item-id="{{this.id}}">
                    {{localize "SANDBOX_SETTLEMENT_MANAGER.purchase.buy"}}
                  </button>
                  {{/if}}
                </td>
              </tr>
              {{else}}
              <tr><td class="ssm-empty" colspan="4"><em>{{localize "SANDBOX_SETTLEMENT_MANAGER.inn.menu.noItems"}}</em></td></tr>
              {{/each}}
            </tbody>
          </table>
        </div>
        {{/each}}
        {{else}}
        <p class="inn-coming-soon"><em>
          {{#if this.innData.isGM}}{{localize "SANDBOX_SETTLEMENT_MANAGER.inn.menu.notConfiguredGM"}}
          {{else}}{{localize "SANDBOX_SETTLEMENT_MANAGER.inn.menu.notConfigured"}}{{/if}}
        </em></p>
        {{/if}}
      </div>

    </div>
    {{else if this.isMerchant}}
    <div class="merchant-detail">
      <div class="inn-section">
        <div class="inn-section-header">
          <span class="inn-section-title">{{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.inventory"}}</span>
          {{#if this.merchantData.isGM}}
          {{#if this.merchantData.canRestore}}
          <button type="button" class="icon" data-action="restoreFromMerchantTemplate"
                  aria-label="{{localize 'SANDBOX_SETTLEMENT_MANAGER.merchant.restore.buttonLabel'}}">
            <i class="fa-solid fa-rotate-left"></i>
          </button>
          {{/if}}
          <button type="button" class="icon" data-action="addManualInventoryItem"
                  aria-label="{{localize 'SANDBOX_SETTLEMENT_MANAGER.merchant.addItem'}}">
            <i class="fa-solid fa-plus"></i>
          </button>
          {{/if}}
        </div>
        {{#if this.merchantData.isGM}}
        <div class="merchant-drop-zone">
          <i class="fa-solid fa-box-open"></i>
          <span>{{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.dropHint"}}</span>
        </div>
        {{/if}}
        {{#if this.merchantData.hasGroups}}
        {{#each this.merchantData.groups}}
        <div class="merchant-type-group">
          <h5 class="merchant-type-label">{{this.label}}</h5>
          <table class="merchant-inventory-table ssm-table">
            <thead>
              <tr>
                {{#if ../merchantData.isGM}}<th class="ssm-col-controls"></th>{{/if}}
                <th class="col-name">{{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.colItem"}}</th>
                {{#each this.attributes}}<th>{{this.label}}</th>{{/each}}
                <th class="col-price ssm-col-right">{{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.colPrice"}}</th>
                <th class="col-stock ssm-col-right">{{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.colStock"}}</th>
                <th class="ssm-col-action"></th>
              </tr>
            </thead>
            <tbody>
              {{#each this.items}}
              <tr>
                {{#if ../../merchantData.isGM}}
                <td class="ssm-col-controls">
                  <button type="button" class="icon lodging-ctrl-btn" data-action="editMerchantItem"
                          data-item-id="{{this.id}}" aria-label="{{localize 'SANDBOX_SETTLEMENT_MANAGER.resource.edit'}}">
                    <i class="fa-solid fa-pen-to-square"></i>
                  </button>
                  <button type="button" class="icon lodging-ctrl-btn" data-action="deleteMerchantItem"
                          data-item-id="{{this.id}}" aria-label="{{localize 'SANDBOX_SETTLEMENT_MANAGER.resource.delete'}}">
                    <i class="fa-solid fa-trash"></i>
                  </button>
                </td>
                {{/if}}
                <td class="col-name">{{this.name}}</td>
                {{#each this.attrCells}}<td>{{this.value}}</td>{{/each}}
                <td class="col-price ssm-col-right">{{this.priceLabel}}</td>
                <td class="col-stock ssm-col-right">{{this.stockLabel}}</td>
                <td class="ssm-col-action">
                  {{#if this.price}}
                  <button type="button" class="buy-button" data-action="buyInventoryItem"
                          data-item-id="{{this.id}}" {{#if this.isSoldOut}}disabled{{/if}}>
                    {{localize "SANDBOX_SETTLEMENT_MANAGER.purchase.buy"}}
                  </button>
                  {{/if}}
                </td>
              </tr>
              {{else}}
              <tr><td class="ssm-empty" colspan="99"><em>{{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.empty"}}</em></td></tr>
              {{/each}}
            </tbody>
          </table>
        </div>
        {{/each}}
        {{else}}
        <table class="merchant-inventory-table ssm-table">
          <thead>
            <tr>
              {{#if this.merchantData.isGM}}<th class="ssm-col-controls"></th>{{/if}}
              <th class="col-name">{{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.colItem"}}</th>
              <th class="col-price ssm-col-right">{{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.colPrice"}}</th>
              <th class="col-stock ssm-col-right">{{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.colStock"}}</th>
              <th class="ssm-col-action"></th>
            </tr>
          </thead>
          <tbody>
            {{#each this.merchantData.flatInventory}}
            <tr>
              {{#if ../merchantData.isGM}}
              <td class="ssm-col-controls">
                <button type="button" class="icon lodging-ctrl-btn" data-action="editMerchantItem"
                        data-item-id="{{this.id}}" aria-label="{{localize 'SANDBOX_SETTLEMENT_MANAGER.resource.edit'}}">
                  <i class="fa-solid fa-pen-to-square"></i>
                </button>
                <button type="button" class="icon lodging-ctrl-btn" data-action="deleteMerchantItem"
                        data-item-id="{{this.id}}" aria-label="{{localize 'SANDBOX_SETTLEMENT_MANAGER.resource.delete'}}">
                  <i class="fa-solid fa-trash"></i>
                </button>
              </td>
              {{/if}}
              <td class="col-name">{{this.name}}</td>
              <td class="col-price ssm-col-right">{{this.priceLabel}}</td>
              <td class="col-stock ssm-col-right">{{this.stockLabel}}</td>
              <td class="ssm-col-action">
                {{#if this.price}}
                <button type="button" class="buy-button" data-action="buyInventoryItem"
                        data-item-id="{{this.id}}" {{#if this.isSoldOut}}disabled{{/if}}>
                  {{localize "SANDBOX_SETTLEMENT_MANAGER.purchase.buy"}}
                </button>
                {{/if}}
              </td>
            </tr>
            {{else}}
            <tr><td class="ssm-empty" colspan="5"><em>{{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.empty"}}</em></td></tr>
            {{/each}}
          </tbody>
        </table>
        {{/if}}
      </div>
    </div>

    {{else if this.isCurrencyTest}}
    <table class="expense-table ssm-table">
      <thead>
        <tr>
          <th class="col-name">{{localize "SANDBOX_SETTLEMENT_MANAGER.currencyTest.table.colItem"}}</th>
          <th class="col-cost ssm-col-right">{{localize "SANDBOX_SETTLEMENT_MANAGER.currencyTest.table.colCost"}}</th>
          <th class="ssm-col-action"></th>
        </tr>
      </thead>
      <tbody>
        {{#each this.expenses}}
        <tr class="expense-row" data-expense-id="{{this.id}}">
          <td class="col-name">{{this.name}}</td>
          <td class="col-cost ssm-col-right">{{this.costLabel}}</td>
          <td class="ssm-col-action">
            <button type="button" class="buy-button" data-action="buyExpense">
              {{localize "SANDBOX_SETTLEMENT_MANAGER.purchase.buy"}}
            </button>
          </td>
        </tr>
        {{else}}
        <tr>
          <td class="ssm-empty" colspan="3"><em>{{localize "SANDBOX_SETTLEMENT_MANAGER.currencyTest.noExpenses"}}</em></td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{else if this.isBank}}
    <div class="ssm-bank-detail">
      <div class="ssm-bank-actor-row">
        <label class="ssm-bank-actor-label">{{localize "SANDBOX_SETTLEMENT_MANAGER.bank.characterLabel"}}:</label>
        <select class="ssm-bank-actor-select">
          <option value="">— {{localize "SANDBOX_SETTLEMENT_MANAGER.bank.selectCharacter"}} —</option>
          {{#each this.bankData.ownedActors}}
          <option value="{{this.id}}"{{#if (eq this.id ../bankData.selectedActorId)}} selected{{/if}}>{{this.name}}</option>
          {{/each}}
        </select>
        {{#if this.bankData.isGM}}
        <div class="ssm-bank-settings-bar">
          {{#if this.bankData.isOverridden}}
          <span class="ssm-bank-settings-badge is-overridden" title="{{localize 'SANDBOX_SETTLEMENT_MANAGER.bank.settingsOverridden'}}">
            <i class="fa-solid fa-pen-to-square"></i>
          </span>
          <button type="button" data-action="overrideBankSettings" class="ssm-settings-btn">
            {{localize "SANDBOX_SETTLEMENT_MANAGER.bank.editOverride"}}
          </button>
          {{#if this.bankData.hasTemplate}}
          <button type="button" data-action="resetBankSettings" class="ssm-settings-btn ssm-settings-reset-btn">
            <i class="fa-solid fa-rotate-left"></i> {{localize "SANDBOX_SETTLEMENT_MANAGER.bank.resetToTemplate"}}
          </button>
          {{/if}}
          {{else}}
          <button type="button" data-action="overrideBankSettings" class="ssm-settings-btn">
            <i class="fa-solid fa-unlock"></i> {{localize "SANDBOX_SETTLEMENT_MANAGER.bank.override"}}
          </button>
          {{/if}}
        </div>
        {{/if}}
      </div>

      {{#if this.bankData.selectedActorId}}
      <div class="ssm-bank-balances">
        {{#each this.bankData.balances}}
        {{#if this.amount}}
        <span class="ssm-bank-balance-item">{{this.amount}} {{this.abbreviation}}</span>
        {{/if}}
        {{/each}}
      </div>
      {{/if}}
      {{#if this.bankData.doesExchange}}
      <fieldset class="ssm-bank-exchange" data-fee-rate="{{this.bankData.exchangeFee}}">
        <legend>{{localize "SANDBOX_SETTLEMENT_MANAGER.bank.exchangeTitle"}}{{#if this.bankData.exchangeFee}} ({{this.bankData.exchangeFee}}% {{localize "SANDBOX_SETTLEMENT_MANAGER.bank.feeLabel"}}){{/if}}</legend>
        <div class="ssm-exchange-row">
          <input type="number" data-field="fromAmount" class="ssm-exchange-amount" min="1" step="1" placeholder="0">
          <select data-field="fromCurrency" class="ssm-exchange-currency-select">
            {{#each this.bankData.currencies}}<option value="{{this.id}}" data-rate="{{this.exchangeRate}}" data-balance="{{this.balance}}"{{#if (eq this.id ../bankData.defaultFromCurrencyId)}} selected{{/if}}>{{this.abbreviation}}</option>{{/each}}
          </select>
          <div class="ssm-exchange-middle">
            <span class="ssm-exchange-fee-preview"></span>
            <i class="fa-solid fa-arrow-right ssm-exchange-arrow" inert></i>
          </div>
          <input type="text" data-field="toAmountPreview" class="ssm-exchange-amount ssm-exchange-preview" readonly placeholder="0">
          <select data-field="toCurrency" class="ssm-exchange-currency-select">
            {{#each this.bankData.currencies}}<option value="{{this.id}}" data-rate="{{this.exchangeRate}}" data-balance="{{this.balance}}"{{#if (eq this.id ../bankData.defaultToCurrencyId)}} selected{{/if}}>{{this.abbreviation}}</option>{{/each}}
          </select>
          <button type="button" data-action="addExchangeToCart" class="ssm-exchange-btn">
            {{localize "SANDBOX_SETTLEMENT_MANAGER.bank.exchangeButton"}}
          </button>
        </div>
      </fieldset>
      {{/if}}

      <fieldset class="ssm-bank-section ssm-bank-deposits">
        <legend>{{localize "SANDBOX_SETTLEMENT_MANAGER.bank.depositsTitle"}}</legend>
        {{#if this.bankData.selectedActorId}}
        <div class="ssm-deposit-info-bar">
          {{#if this.bankData.depositSettings.depositFee}}<span>{{localize "SANDBOX_SETTLEMENT_MANAGER.bank.deposits.depositFeeLabel"}}: {{this.bankData.depositSettings.depositFee}}%</span>{{/if}}
          {{#if this.bankData.depositSettings.minDepositDays}}<span>{{localize "SANDBOX_SETTLEMENT_MANAGER.bank.deposits.minDepositDaysLabel"}}: {{this.bankData.depositSettings.minDepositDays}}d</span>{{/if}}
          {{#if this.bankData.depositSettings.earlyWithdrawalFee}}<span>{{localize "SANDBOX_SETTLEMENT_MANAGER.bank.deposits.earlyWithdrawalFeeLabel"}}: {{this.bankData.depositSettings.earlyWithdrawalFee}}%</span>{{/if}}
        </div>
        <div class="ssm-deposit-form">
          {{#each this.bankData.currencies}}
          <div class="ssm-deposit-currency-row">
            <label class="ssm-deposit-currency-label">{{this.abbreviation}}</label>
            <input type="number" class="ssm-deposit-amount-input"
                   data-currency-id="{{this.id}}"
                   min="0" max="{{this.balance}}" step="1" placeholder="0">
          </div>
          {{/each}}
          <button type="button" data-action="depositCoins" class="ssm-deposit-btn">
            {{localize "SANDBOX_SETTLEMENT_MANAGER.bank.deposits.depositButton"}}
          </button>
        </div>
        {{#if this.bankData.processedDeposits.length}}
        <hr class="ssm-deposit-separator">
        <ul class="ssm-deposits-list">
          {{#each this.bankData.processedDeposits}}
          <li class="ssm-deposit-entry{{#if this.matured}} ssm-deposit-matured{{/if}}">
            <span class="ssm-deposit-coins">{{this.coinsLabel}}</span>
            <span class="ssm-deposit-time">{{this.timeRemainingLabel}}</span>
            <button type="button" data-action="withdrawDeposit"
                    data-deposit-ids="{{this.idsJson}}" class="ssm-withdraw-btn">
              {{localize "SANDBOX_SETTLEMENT_MANAGER.bank.deposits.withdrawButton"}}
            </button>
          </li>
          {{/each}}
        </ul>
        <div class="ssm-deposits-total">{{localize "SANDBOX_SETTLEMENT_MANAGER.bank.deposits.total"}}: {{this.bankData.depositsTotal}}</div>
        {{else}}
        {{#if this.bankData.selectedActorId}}<p class="ssm-bank-placeholder"><em>{{localize "SANDBOX_SETTLEMENT_MANAGER.bank.deposits.noDeposits"}}</em></p>{{/if}}
        {{/if}}
        {{/if}}
      </fieldset>

      <fieldset class="ssm-bank-section">
        <legend>{{localize "SANDBOX_SETTLEMENT_MANAGER.bank.loansTitle"}}</legend>
        <p class="ssm-bank-placeholder">{{localize "SANDBOX_SETTLEMENT_MANAGER.bank.comingSoon"}}</p>
      </fieldset>
    </div>
    {{else}}
    <p class="notification info">{{localize "SANDBOX_SETTLEMENT_MANAGER.resource.noDetailView"}}</p>
    {{/if}}
  </div>
  {{/each}}

  {{#if hasSellTab}}
  <div class="resource-detail-tab-pane{{#if sellTabActive}} active{{/if}}">
    <div class="ssm-sell-tab">
      <div class="ssm-sell-tab-header">
        {{#if isGM}}
        <button type="button" data-action="editPurchasingProfile" class="ssm-edit-profile-btn">
          <i class="fa-solid fa-pen-to-square"></i> {{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.editProfile"}}
        </button>
        {{/if}}
        {{#if sellData.hasConflicts}}
        <div class="ssm-conflict-warning">
          <i class="fa-solid fa-triangle-exclamation"></i>
          {{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.conflictWarning"}}
        </div>
        {{/if}}
      </div>

      {{#if sellData.actors.length}}
      <div class="form-group ssm-sell-actor-row">
        <label>{{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.sellCharacter"}}</label>
        <select class="ssm-sell-actor-select">
          {{#each sellData.actors}}
          <option value="{{this.id}}"{{#if this.selected}} selected{{/if}}>{{this.name}}</option>
          {{/each}}
        </select>
      </div>
      {{/if}}

      {{#if sellData.sellableItems.length}}
      <table class="ssm-sell-table ssm-table">
        <thead>
          <tr>
            <th>{{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.colItem"}}</th>
            <th>{{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.colSellPrice"}}</th>
            <th class="col-num">{{localize "SANDBOX_SETTLEMENT_MANAGER.cart.qty"}}</th>
            <th class="ssm-col-action"></th>
          </tr>
        </thead>
        <tbody>
          {{#each sellData.sellableItems}}
          <tr>
            <td>{{this.name}}<br><small class="ssm-item-type-label">{{this.typeLabel}}</small></td>
            <td>{{this.salePriceLabel}}</td>
            <td class="col-num">
              <input type="number" class="ssm-sell-qty" value="1" min="1"
                     data-actor-item-id="{{this.actorItemId}}">
            </td>
            <td class="ssm-col-action">
              <button type="button" class="buy-button"
                      data-action="addToSellCart" data-actor-item-id="{{this.actorItemId}}">
                {{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.sellButton"}}
              </button>
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
      {{else}}
      <p class="notification info">{{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.noSellableItems"}}</p>
      {{/if}}

      {{#if sellData.buybackItems.length}}
      <div class="ssm-buyback-section">
        <h4 class="ssm-section-heading">{{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.buybackSection"}}</h4>
        <table class="ssm-buyback-table ssm-table">
          <tbody>
            {{#each sellData.buybackItems}}
            <tr>
              <td>{{this.itemName}}</td>
              <td>{{this.buybackPriceLabel}}</td>
              <td class="ssm-col-action">
                <button type="button" class="buy-button"
                        data-action="buyBackItem" data-buyback-id="{{this.id}}">
                  {{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.buyBackButton"}}
                </button>
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
      {{/if}}
    </div>
  </div>
  {{/if}}
</div>
