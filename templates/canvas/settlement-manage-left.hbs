<div class="settlement-left-pane">
  <div class="settlement-controls">
    <input type="text" name="settlementName" value="{{settlementName}}"
           placeholder="{{localize 'SANDBOX_SETTLEMENT_MANAGER.manage.settlementNamePlaceholder'}}"
           class="settlement-name-input">
    <select name="settlementType" class="settlement-type-select">
      <option value="">— {{localize "SANDBOX_SETTLEMENT_MANAGER.manage.settlementType"}} —</option>
      {{#each settlementTypes}}
      <option value="{{value}}"{{#if (eq value ../selectedType)}} selected{{/if}}>{{label}}</option>
      {{/each}}
    </select>
    <button type="button" data-action="addLocation" class="settlement-add-location-btn">
      <i class="fa-solid fa-plus"></i> {{localize "SANDBOX_SETTLEMENT_MANAGER.location.add"}}
    </button>
  </div>
  <hr class="settlement-pane-divider">
  <ul class="settlement-location-list">
    {{#each locations}}
    <li class="settlement-location-row{{#if this.selected}} selected{{/if}}"
        data-location-id="{{this.id}}"
        data-action="selectLocation">
      <button type="button" class="discovered-toggle{{#if this.discovered.default}} is-discovered{{/if}}"
              data-action="toggleDiscovered"
              aria-label="{{#if this.discovered.default}}{{localize 'SANDBOX_SETTLEMENT_MANAGER.location.discovered'}}{{else}}{{localize 'SANDBOX_SETTLEMENT_MANAGER.location.undiscovered'}}{{/if}}">
        <i class="{{#if this.discovered.default}}fa-solid fa-eye{{else}}fa-regular fa-eye-slash{{/if}}"></i>
      </button>
      <i class="{{this.typeIcon}} settlement-type-icon" inert></i>
      <div class="settlement-location-info">
        <span class="settlement-location-name">{{this.name}}</span>
        <span class="settlement-location-type">{{this.typeName}}</span>
      </div>
    </li>
    {{else}}
    <li class="settlement-location-empty">
      <em>{{localize "SANDBOX_SETTLEMENT_MANAGER.location.empty"}}</em>
    </li>
    {{/each}}
  </ul>
</div>
