{{#if selectedLocation}}
<div class="settlement-right-pane" data-location-id="{{selectedLocation.id}}">

  <div class="location-header-row">
    <input type="text" name="locationName" value="{{selectedLocation.name}}"
           class="location-name-input">
    <button type="button" class="icon" data-action="deleteLocation"
            data-location-id="{{selectedLocation.id}}"
            aria-label="{{localize 'SANDBOX_SETTLEMENT_MANAGER.location.delete'}}">
      <i class="fa-solid fa-trash"></i>
    </button>
  </div>

  <div class="location-types-section">
    <div class="location-type-chips">
      {{#each selectedLocation.typeEntries}}
      <span class="type-entry-chip">
        <i class="{{this.typeIcon}}" inert></i>
        <span>{{this.typeName}}{{#if this.subTypeName}} &middot; {{this.subTypeName}}{{/if}}</span>
        <button type="button" class="icon remove-chip" data-action="removeTypeEntry"
                data-entry-index="{{this.index}}" aria-label="Remove">
          <i class="fa-solid fa-times"></i>
        </button>
      </span>
      {{/each}}
      {{#if selectedLocation.hasAvailableTypes}}
      <div class="add-type-trigger location-add-type-trigger">
        <button type="button" class="add-type-btn">
          <i class="fa-solid fa-plus"></i> {{localize "SANDBOX_SETTLEMENT_MANAGER.location.addType"}}
        </button>
        <div class="type-picker-dropdown location-type-picker-dropdown">
          <input type="text" class="type-picker-filter"
                 placeholder="{{localize 'SANDBOX_SETTLEMENT_MANAGER.location.filterTypes'}}">
          <ul class="type-picker-list">
            {{#each selectedLocation.pickerGroups}}
            <li class="picker-group">
              {{#if this.typeItselfAvailable}}
              <button type="button" class="picker-item picker-type-item"
                      data-type-id="{{this.typeId}}" data-sub-type-id="">
                <i class="{{this.icon}}" inert></i> {{this.name}}
              </button>
              {{else}}
              <span class="picker-group-label">
                <i class="{{this.icon}}" inert></i> {{this.name}}
              </span>
              {{/if}}
              {{#each this.subTypes}}
              <button type="button" class="picker-item picker-subtype-item"
                      data-type-id="{{../typeId}}" data-sub-type-id="{{this.id}}">
                <i class="fa-solid fa-turn-down-right" inert></i> {{this.name}}
              </button>
              {{/each}}
            </li>
            {{/each}}
          </ul>
        </div>
      </div>
      {{/if}}
    </div>
  </div>

  {{#if selectedLocation.hasDetails}}
  <hr class="location-detail-divider">

  {{#each selectedLocation.sections}}

  {{#if this.isInn}}
  <div class="inn-detail">
    <div class="inn-section">
      <div class="inn-section-header">
        <span class="inn-section-title">{{localize "SANDBOX_SETTLEMENT_MANAGER.inn.lodgingSection"}}</span>
        {{#if this.innData.isGM}}
        <button type="button" class="icon" data-action="addLodging" aria-label="Add Lodging">
          <i class="fa-solid fa-plus"></i>
        </button>
        {{/if}}
      </div>
      <ul class="inn-lodging-list">
        {{#each this.innData.lodgings}}
        <li class="inn-lodging-row">
          <div class="lodging-info">
            <span class="lodging-name">{{this.name}}</span>
            <span class="lodging-meta">{{this.beds}} beds &middot; {{this.pricePerDayLabel}}/day &middot; {{this.pricePerWeekLabel}}/wk</span>
          </div>
          <div class="controls">
            {{#if ../innData.isGM}}
            <button type="button" class="icon" data-action="editLodging" data-lodging-id="{{this.id}}"
                    aria-label="{{localize 'SANDBOX_SETTLEMENT_MANAGER.location.edit'}}">
              <i class="fa-solid fa-pen-to-square"></i>
            </button>
            <button type="button" class="icon" data-action="deleteLodging" data-lodging-id="{{this.id}}"
                    aria-label="{{localize 'SANDBOX_SETTLEMENT_MANAGER.location.delete'}}">
              <i class="fa-solid fa-trash"></i>
            </button>
            {{/if}}
            <button type="button" class="inn-rent-btn" data-action="rentLodging" data-lodging-id="{{this.id}}">
              {{localize "SANDBOX_SETTLEMENT_MANAGER.inn.rent"}}
            </button>
          </div>
        </li>
        {{else}}
        <li class="inn-empty"><em>{{localize "SANDBOX_SETTLEMENT_MANAGER.inn.noLodgings"}}</em></li>
        {{/each}}
      </ul>
    </div>

    <div class="inn-section">
      <div class="inn-section-header">
        <span class="inn-section-title">{{localize "SANDBOX_SETTLEMENT_MANAGER.inn.ledger"}}</span>
      </div>
      <ul class="inn-ledger-list">
        {{#each this.innData.ledger}}
        <li class="inn-ledger-entry{{#if this.isExpired}} expired{{/if}}">
          <div class="ledger-info">
            <span class="ledger-who">{{this.actorName}}</span>
            <span class="ledger-what">{{this.lodgingName}} ({{this.beds}} beds)</span>
            <span class="ledger-time">{{this.timeRemainingLabel}}</span>
          </div>
          {{#if ../innData.isGM}}
          <button type="button" class="icon" data-action="dismissLedgerEntry" data-entry-id="{{this.id}}"
                  aria-label="Dismiss">
            <i class="fa-solid fa-times"></i>
          </button>
          {{/if}}
        </li>
        {{else}}
        <li class="inn-empty"><em>{{localize "SANDBOX_SETTLEMENT_MANAGER.inn.noBookings"}}</em></li>
        {{/each}}
      </ul>
    </div>

    <div class="inn-section">
      <div class="inn-section-header">
        <span class="inn-section-title">{{localize "SANDBOX_SETTLEMENT_MANAGER.inn.menu"}}</span>
      </div>
      <p class="inn-coming-soon"><em>{{localize "SANDBOX_SETTLEMENT_MANAGER.inn.menuComingSoon"}}</em></p>
    </div>
  </div>

  {{else}}
  <p class="notification info">{{localize "SANDBOX_SETTLEMENT_MANAGER.location.noDetailView"}}</p>
  {{/if}}

  {{/each}}
  {{/if}}

</div>
{{else}}
<div class="settlement-right-placeholder">
  <p>{{localize "SANDBOX_SETTLEMENT_MANAGER.manage.selectLocation"}}</p>
</div>
{{/if}}
