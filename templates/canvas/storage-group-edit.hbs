<div class="storage-group-edit-form">
  <div class="form-group">
    <label>{{localize "SANDBOX_SETTLEMENT_MANAGER.storage.group.nameLabel"}}</label>
    <input type="text" name="name" value="{{name}}"
           placeholder="{{localize 'SANDBOX_SETTLEMENT_MANAGER.storage.group.namePlaceholder'}}">
  </div>

  <div class="form-group">
    <label>{{localize "SANDBOX_SETTLEMENT_MANAGER.storage.group.storageTypeLabel"}}</label>
    <select name="storageTypeId">
      {{#each storageTypeOptions}}
      <option value="{{this.id}}"{{#if this.selected}} selected{{/if}}>{{this.name}}</option>
      {{/each}}
    </select>
  </div>

  <div class="form-group">
    <label>{{localize "SANDBOX_SETTLEMENT_MANAGER.storage.group.policyOverrideLabel"}} <i class="fa-solid fa-circle-question ssm-help" data-tooltip="{{localize 'SANDBOX_SETTLEMENT_MANAGER.help.retrievalPolicy'}}"></i></label>
    <select name="retrievalPolicyOverride">
      {{#each policyOptions}}
      <option value="{{this.value}}"{{#if this.selected}} selected{{/if}}>{{this.label}}</option>
      {{/each}}
    </select>
  </div>

  <fieldset class="storage-access-fieldset">
    <legend>{{localize "SANDBOX_SETTLEMENT_MANAGER.storage.group.accessListLabel"}}</legend>
    <div class="storage-access-list">
      {{#each accessRows}}
      <div class="storage-access-row">
        <span class="storage-access-name">{{this.actorName}}</span>
        <select class="storage-access-level-select" data-actor-id="{{this.actorId}}">
          <option value="primary"{{#if this.isPrimary}} selected{{/if}}>{{localize "SANDBOX_SETTLEMENT_MANAGER.storage.access.primary"}}</option>
          <option value="guest"{{#unless this.isPrimary}} selected{{/unless}}>{{localize "SANDBOX_SETTLEMENT_MANAGER.storage.access.guest"}}</option>
        </select>
        <button type="button" class="icon storage-access-remove-btn" data-action="removeAccessMember" data-actor-id="{{this.actorId}}"
                aria-label="{{localize 'SANDBOX_SETTLEMENT_MANAGER.location.delete'}}">
          <i class="fa-solid fa-trash"></i>
        </button>
      </div>
      {{else}}
      <p class="storage-access-empty"><em>{{localize "SANDBOX_SETTLEMENT_MANAGER.storage.group.noActors"}}</em></p>
      {{/each}}
    </div>
    <button type="button" class="storage-access-add-btn" data-action="addAccessMembers">
      <i class="fa-solid fa-plus"></i> {{localize "SANDBOX_SETTLEMENT_MANAGER.storage.access.add"}}
    </button>
  </fieldset>
</div>
