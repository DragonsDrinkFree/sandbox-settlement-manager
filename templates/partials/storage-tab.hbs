<div class="ssm-storage-detail">
  {{#if this.isGM}}
  <div class="inn-section">
    <div class="inn-section-header">
      <span class="inn-section-title">{{localize "SANDBOX_SETTLEMENT_MANAGER.storage.storageTypesLegend"}}</span>
      <div class="inn-section-actions">
        <button type="button" class="icon" data-action="editLocationEntry"
                aria-label="{{localize 'SANDBOX_SETTLEMENT_MANAGER.location.editEntry'}}">
          <i class="fa-solid fa-gear"></i>
        </button>
      </div>
    </div>
  </div>
  {{/if}}

  <div class="inn-section">
    <div class="inn-section-header">
      <span class="inn-section-title">{{localize "SANDBOX_SETTLEMENT_MANAGER.storage.group.sectionTitle"}}</span>
      {{#if this.isGM}}
      <div class="inn-section-actions">
        <button type="button" class="storage-add-group-btn" data-action="addStorageGroup"{{#unless this.hasStorageTypes}} disabled{{/unless}}>
          <i class="fa-solid fa-plus"></i> {{localize "SANDBOX_SETTLEMENT_MANAGER.storage.group.add"}}
        </button>
      </div>
      {{/if}}
    </div>

    {{#if this.hasGroups}}
    {{#each this.groups}}
    <div class="storage-group-section" data-group-id="{{this.id}}">
      <div class="storage-group-header">
        <span class="storage-group-name">{{this.name}}</span>
        <span class="storage-group-type-badge">{{this.storageTypeName}}
          <i class="fa-solid fa-circle-question ssm-help" data-tooltip="{{{this.policyTooltip}}}"></i>
        </span>
        <span class="storage-group-weight">{{localize "SANDBOX_SETTLEMENT_MANAGER.storage.group.capacityLabel"}}: {{this.weightLabel}}</span>
        {{#if ../isGM}}
        <div class="storage-access-badge-widget">
          <button type="button" class="storage-access-badge">
            <i class="fa-solid fa-users"></i> {{this.access.length}}
          </button>
          <i class="fa-solid fa-circle-question ssm-help" data-tooltip="{{localize 'SANDBOX_SETTLEMENT_MANAGER.help.storageAccessLevels'}}"></i>
          <div class="ssm-storage-access-badge-dropdown">
            {{#each this.access}}
            <div class="ssm-storage-access-badge-row">
              <span class="ssm-storage-access-badge-name">{{this.actorName}}</span>
              <span class="ssm-storage-access-badge-level{{#if this.isPrimary}} is-primary{{/if}}">
                {{#if this.isPrimary}}{{localize "SANDBOX_SETTLEMENT_MANAGER.storage.access.primary"}}{{else}}{{localize "SANDBOX_SETTLEMENT_MANAGER.storage.access.guest"}}{{/if}}
              </span>
            </div>
            {{else}}
            <p class="ssm-storage-access-badge-empty"><em>{{localize "SANDBOX_SETTLEMENT_MANAGER.storage.group.noAccess"}}</em></p>
            {{/each}}
          </div>
        </div>
        <div class="storage-group-controls">
          <button type="button" class="icon{{#if this.hasNote}} has-note{{/if}}" data-action="editStorageGroupNote" data-group-id="{{this.id}}"
                  aria-label="{{localize 'SANDBOX_SETTLEMENT_MANAGER.storage.group.noteTooltip'}}"
                  data-tooltip="{{localize 'SANDBOX_SETTLEMENT_MANAGER.storage.group.noteTooltip'}}">
            <i class="fa-solid fa-note-sticky"></i>
          </button>
          <button type="button" class="icon" data-action="editStorageGroup" data-group-id="{{this.id}}"
                  aria-label="{{localize 'SANDBOX_SETTLEMENT_MANAGER.location.edit'}}">
            <i class="fa-solid fa-pen-to-square"></i>
          </button>
          <button type="button" class="icon" data-action="deleteStorageGroup" data-group-id="{{this.id}}"
                  aria-label="{{localize 'SANDBOX_SETTLEMENT_MANAGER.location.delete'}}">
            <i class="fa-solid fa-trash"></i>
          </button>
        </div>
        {{else if this.canManageGuests}}
        <button type="button" class="storage-manage-guests-btn" data-action="manageStorageGuests" data-group-id="{{this.id}}">
          <i class="fa-solid fa-user-group"></i> {{localize "SANDBOX_SETTLEMENT_MANAGER.storage.access.manageGuests"}}
        </button>
        {{/if}}
      </div>

      <div class="storage-group-drop-zone" data-group-id="{{this.id}}">
        <i class="fa-solid fa-box-open"></i>
        <span>{{localize "SANDBOX_SETTLEMENT_MANAGER.storage.dropHint"}}</span>
      </div>

      {{#if this.depositors.length}}
      <div class="storage-item-table-wrap">
        <input type="text" class="storage-item-filter"
               placeholder="{{localize 'SANDBOX_SETTLEMENT_MANAGER.storage.item.filterPlaceholder'}}">
        {{#each this.depositors}}
        <div class="storage-item-depositor-group">
          <h5 class="storage-item-depositor-name">{{this.actorName}}</h5>
          <table class="storage-item-table ssm-table">
            <thead>
              <tr>
                <th class="col-name" data-sort-key="name">{{localize "SANDBOX_SETTLEMENT_MANAGER.storage.colName"}}</th>
                <th class="col-num ssm-col-center" data-sort-key="quantity">{{localize "SANDBOX_SETTLEMENT_MANAGER.storage.item.colQuantity"}}</th>
                <th class="col-num ssm-col-center" data-sort-key="weight">{{localize "SANDBOX_SETTLEMENT_MANAGER.storage.item.colWeight"}}</th>
                <th class="col-auto ssm-col-center" data-sort-key="groupAccessible">{{localize "SANDBOX_SETTLEMENT_MANAGER.storage.item.colGroupAccessible"}}</th>
                <th class="ssm-col-action">&nbsp;</th>
              </tr>
            </thead>
            <tbody>
              {{#each this.items}}
              <tr class="storage-item-row"
                  data-name="{{this.itemName}}"
                  data-quantity="{{this.quantity}}" data-weight="{{this.weight}}"
                  data-group-accessible="{{#if this.isGroupProperty}}1{{else}}0{{/if}}">
                <td class="col-name">
                  <a class="storage-item-name-link" data-action="viewStorageItem" data-item-id="{{this.id}}">{{this.itemName}}</a>
                  {{#if this.ownershipLabel}}<span class="storage-item-ownership-badge">{{this.ownershipLabel}}</span>{{/if}}
                </td>
                <td class="col-num ssm-col-center">{{this.quantity}}</td>
                <td class="col-num ssm-col-center">{{this.weight}}</td>
                <td class="col-auto ssm-col-center">
                  <input type="checkbox" class="storage-group-accessible-checkbox" data-item-id="{{this.id}}"
                         {{#if this.isGroupProperty}}checked{{/if}}
                         {{#unless this.canManageOwnership}}disabled{{/unless}}>
                </td>
                <td class="ssm-col-action">
                  {{#if this.canTake}}
                  <button type="button" class="buy-button" data-action="takeStorageItem" data-item-id="{{this.id}}">
                    {{localize "SANDBOX_SETTLEMENT_MANAGER.storage.item.take"}}
                  </button>
                  {{/if}}
                  {{#if this.canManageOwnership}}
                  <button type="button" class="icon" data-action="giveToActor" data-item-id="{{this.id}}"
                          aria-label="{{localize 'SANDBOX_SETTLEMENT_MANAGER.storage.item.giveToActor'}}"
                          data-tooltip="{{localize 'SANDBOX_SETTLEMENT_MANAGER.storage.item.giveToActor'}}">
                    <i class="fa-solid fa-hand-holding-heart"></i>
                  </button>
                  {{#if this.isAssigned}}
                  <button type="button" class="icon" data-action="resetItemOwnership" data-item-id="{{this.id}}"
                          aria-label="{{localize 'SANDBOX_SETTLEMENT_MANAGER.storage.item.resetOwnership'}}"
                          data-tooltip="{{localize 'SANDBOX_SETTLEMENT_MANAGER.storage.item.resetOwnership'}}">
                    <i class="fa-solid fa-rotate-left"></i>
                  </button>
                  {{/if}}
                  {{/if}}
                  {{#if this.isGM}}
                  <button type="button" class="icon storage-item-force-take-btn" data-action="forceTakeStorageItem" data-item-id="{{this.id}}"
                          aria-label="{{localize 'SANDBOX_SETTLEMENT_MANAGER.storage.item.forceTake'}}"
                          data-tooltip="{{localize 'SANDBOX_SETTLEMENT_MANAGER.storage.item.forceTakeTitle'}}">
                    <i class="fa-solid fa-user-shield"></i>
                  </button>
                  {{/if}}
                </td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
        {{/each}}
      </div>
      {{else}}
      <p class="ssm-bank-placeholder"><em>{{localize "SANDBOX_SETTLEMENT_MANAGER.storage.noItems"}}</em></p>
      {{/if}}
    </div>
    {{/each}}
    {{else}}
    <p class="ssm-bank-placeholder"><em>{{localize "SANDBOX_SETTLEMENT_MANAGER.storage.group.none"}}</em></p>
    {{/if}}
  </div>
</div>
