<div class="city-type-manager">
  <p class="hint">{{localize "SANDBOX_SETTLEMENT_MANAGER.setting.cityTypes.hint"}}</p>

  <ul class="city-type-list">
    {{#each cityTypes}}
    <li class="city-type-item" draggable="true" data-index="{{@index}}">
      <i class="fa-solid fa-grip-vertical drag-handle" inert></i>
      <span class="city-type-name">{{this.name}}</span>
      <div class="controls">
        <button type="button" class="icon" data-action="editCityType" data-index="{{@index}}"
                aria-label="{{localize 'SANDBOX_SETTLEMENT_MANAGER.cityType.edit'}}">
          <i class="fa-solid fa-pen-to-square"></i>
        </button>
        <button type="button" class="icon" data-action="deleteCityType" data-index="{{@index}}"
                aria-label="{{localize 'SANDBOX_SETTLEMENT_MANAGER.cityType.delete'}}">
          <i class="fa-solid fa-trash"></i>
        </button>
      </div>
    </li>
    {{else}}
    <li class="city-type-empty">
      <em>{{localize "SANDBOX_SETTLEMENT_MANAGER.cityType.empty"}}</em>
    </li>
    {{/each}}
  </ul>

  <div class="city-type-actions">
    <button type="button" data-action="addCityType">
      <i class="fa-solid fa-plus"></i> {{localize "SANDBOX_SETTLEMENT_MANAGER.setting.cityTypes.add"}}
    </button>
    <button type="button" data-action="resetToDefaults">
      <i class="fa-solid fa-rotate-left"></i> {{localize "SANDBOX_SETTLEMENT_MANAGER.setting.cityTypes.reset"}}
    </button>
  </div>
</div>
