<div class="currency-config">
  <div class="form-group">
    <label>{{localize "SANDBOX_SETTLEMENT_MANAGER.currency.modeLabel"}}
      <details class="ssm-help-details">
        <summary><i class="fa-solid fa-circle-question ssm-help"></i></summary>
        <ul class="ssm-help-list">
          <li><strong>{{localize "SANDBOX_SETTLEMENT_MANAGER.currency.mode.loose"}}:</strong> {{localize "SANDBOX_SETTLEMENT_MANAGER.help.currencyModeLoose"}}</li>
          <li><strong>{{localize "SANDBOX_SETTLEMENT_MANAGER.currency.mode.attribute"}}:</strong> {{localize "SANDBOX_SETTLEMENT_MANAGER.help.currencyModeAttribute"}}</li>
          <li><strong>{{localize "SANDBOX_SETTLEMENT_MANAGER.currency.mode.item"}}:</strong> {{localize "SANDBOX_SETTLEMENT_MANAGER.help.currencyModeItem"}}</li>
        </ul>
      </details>
    </label>
    <select name="mode">
      <option value="loose"{{#if (eq currentMode "loose")}} selected{{/if}}>
        {{localize "SANDBOX_SETTLEMENT_MANAGER.currency.mode.loose"}}
      </option>
      <option value="attribute"{{#if (eq currentMode "attribute")}} selected{{/if}}>
        {{localize "SANDBOX_SETTLEMENT_MANAGER.currency.mode.attribute"}}
      </option>
      <option value="item"{{#if (eq currentMode "item")}} selected{{/if}}>
        {{localize "SANDBOX_SETTLEMENT_MANAGER.currency.mode.item"}}
      </option>
    </select>
  </div>

  {{#if (eq currentMode "loose")}}
    <p class="notification info">{{localize "SANDBOX_SETTLEMENT_MANAGER.currency.modeLooseHint"}}</p>
  {{else if (eq currentMode "attribute")}}
    <p class="notification info">{{localize "SANDBOX_SETTLEMENT_MANAGER.currency.modeAttributeHint"}}</p>
  {{else if (eq currentMode "item")}}
    <p class="notification info">{{localize "SANDBOX_SETTLEMENT_MANAGER.currency.modeItemHint"}}</p>
  {{/if}}

  <h3>{{localize "SANDBOX_SETTLEMENT_MANAGER.currency.listHeader"}} <i class="fa-solid fa-circle-question ssm-help" data-tooltip="{{localize 'SANDBOX_SETTLEMENT_MANAGER.help.currencyList'}}"></i></h3>
  <p class="hint">{{localize "SANDBOX_SETTLEMENT_MANAGER.currency.listHint"}}</p>

  <ul class="currency-list">
    {{#each currencies}}
    <li class="currency-item" draggable="true" data-index="{{@index}}">
      <i class="fa-solid fa-grip-vertical drag-handle" inert></i>
      <div class="currency-info">
        <span class="currency-name">{{this.name}}</span>
        <span class="currency-abbr">({{this.abbreviation}})</span>
        {{#if this.isStandard}}
          <span class="currency-standard-badge">{{localize "SANDBOX_SETTLEMENT_MANAGER.currency.standardBadge"}}</span>
        {{/if}}
        <span class="currency-rate">{{this.exchangeRate}}</span>
        {{#if (eq ../currentMode "attribute")}}
          <span class="currency-secondary">{{this.attributePath}}</span>
        {{else if (eq ../currentMode "item")}}
          <span class="currency-secondary">{{this.itemName}}</span>
        {{/if}}
      </div>
      <div class="controls">
        <button type="button" class="icon" data-action="editCurrency" data-index="{{@index}}"
                aria-label="Edit"><i class="fa-solid fa-pen-to-square"></i></button>
        <button type="button" class="icon" data-action="deleteCurrency" data-index="{{@index}}"
                aria-label="Delete"><i class="fa-solid fa-trash"></i></button>
      </div>
    </li>
    {{else}}
    <li class="currency-empty"><em>{{localize "SANDBOX_SETTLEMENT_MANAGER.currency.empty"}}</em></li>
    {{/each}}
  </ul>

  <div class="currency-actions">
    <button type="button" data-action="addCurrency">
      <i class="fa-solid fa-plus"></i> {{localize "SANDBOX_SETTLEMENT_MANAGER.currency.add"}}
    </button>
    <button type="button" data-action="resetToDefaults">
      <i class="fa-solid fa-rotate-left"></i> {{localize "SANDBOX_SETTLEMENT_MANAGER.currency.reset"}}
    </button>
  </div>
</div>
