<div class="resource-type-config">
  <p class="hint">{{localize "SANDBOX_SETTLEMENT_MANAGER.setting.resourceTypes.hint"}}</p>

  {{#each coreTypes}}
  <div class="core-type-block" data-type-id="{{this.id}}">
    <div class="core-type-row">
      <i class="{{this.icon}}" inert></i>
      <span class="core-type-name">{{this.name}}</span>
      <button type="button" class="icon edit-core-type-btn" data-action="editCoreType" data-type-id="{{this.id}}"
              aria-label="{{localize 'SANDBOX_SETTLEMENT_MANAGER.resourceType.edit'}}">
        <i class="fa-solid fa-pen-to-square"></i>
      </button>
    </div>
    {{#each this.subTypes}}
    <div class="sub-type-row">
      <i class="fa-solid fa-turn-down-right sub-type-indent" inert></i>
      <span class="sub-type-name">{{this.name}}</span>
    </div>
    {{/each}}
  </div>
  {{/each}}
</div>
