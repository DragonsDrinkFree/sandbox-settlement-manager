<div class="resource-type-config">
  <p class="hint">{{localize "SANDBOX_CITY_MANAGER.setting.resourceTypes.hint"}}</p>

  {{#each coreTypes}}
  <div class="core-type-block" data-type-id="{{this.id}}">
    <div class="core-type-row">
      <i class="{{this.icon}}" inert></i>
      <span class="core-type-name">{{this.name}}</span>
      <button type="button" class="icon add-subtype-btn" data-action="addSubType" data-type-id="{{this.id}}"
              aria-label="{{localize 'SANDBOX_CITY_MANAGER.resourceType.subType.add'}}">
        <i class="fa-solid fa-plus"></i>
      </button>
    </div>
    {{#each this.subTypes}}
    <div class="sub-type-row">
      <i class="fa-solid fa-turn-down-right sub-type-indent" inert></i>
      <span class="sub-type-name">{{this.name}}</span>
      <div class="controls">
        <button type="button" class="icon" data-action="editSubType"
                data-type-id="{{../id}}" data-sub-index="{{@index}}"
                aria-label="{{localize 'SANDBOX_CITY_MANAGER.resourceType.subType.edit'}}">
          <i class="fa-solid fa-pen-to-square"></i>
        </button>
        <button type="button" class="icon" data-action="deleteSubType"
                data-type-id="{{../id}}" data-sub-index="{{@index}}"
                aria-label="{{localize 'SANDBOX_CITY_MANAGER.resourceType.subType.delete'}}">
          <i class="fa-solid fa-trash"></i>
        </button>
      </div>
    </div>
    {{/each}}
  </div>
  {{/each}}
</div>
