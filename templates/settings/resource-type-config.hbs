<div class="resource-type-config">
  <p class="hint">{{localize "SANDBOX_SETTLEMENT_MANAGER.setting.resourceTypes.hint"}}</p>

  <ul class="template-flat-list">
    {{#each templates}}
    <li class="sub-type-row">
      <i class="{{this.typeIcon}} sub-type-type-icon" inert></i>
      <span class="sub-type-name">{{this.name}}</span>
      <span class="sub-type-type-label">{{this.typeName}}</span>
      <div class="sub-type-controls">
        <button type="button" class="icon" data-action="editTemplate"
                data-type-id="{{this.typeId}}" data-template-index="{{this.index}}"
                aria-label="{{localize 'SANDBOX_SETTLEMENT_MANAGER.resourceType.subType.edit'}}">
          <i class="fa-solid fa-pen-to-square"></i>
        </button>
        <button type="button" class="icon" data-action="deleteTemplate"
                data-type-id="{{this.typeId}}" data-template-index="{{this.index}}"
                aria-label="{{localize 'SANDBOX_SETTLEMENT_MANAGER.resourceType.subType.delete'}}">
          <i class="fa-solid fa-trash"></i>
        </button>
      </div>
    </li>
    {{else}}
    <li class="sub-type-empty">
      <em>{{localize "SANDBOX_SETTLEMENT_MANAGER.resourceType.noSubTypes"}}</em>
    </li>
    {{/each}}
  </ul>
  <div class="add-template-row">
    <button type="button" data-action="addTemplate">
      <i class="fa-solid fa-plus"></i> {{localize "SANDBOX_SETTLEMENT_MANAGER.resourceType.subType.add"}}
    </button>
  </div>
</div>
