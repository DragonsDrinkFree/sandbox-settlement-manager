<div class="resource-type-edit-form">
  <div class="core-type-header">
    <i class="{{coreType.icon}}" inert></i>
    <span>{{coreType.name}}</span>
  </div>
  <fieldset class="resource-type-subtypes">
    <legend>{{localize "SANDBOX_SETTLEMENT_MANAGER.resourceType.subTypesLabel"}}</legend>
    <ul class="sub-type-list">
      {{#each subTypes}}
      <li class="sub-type-item">
        <span class="sub-type-name">{{this.name}}</span>
        <div class="controls">
          <button type="button" class="icon" data-action="editSubType" data-sub-index="{{@index}}"
                  aria-label="{{localize 'SANDBOX_SETTLEMENT_MANAGER.resourceType.subType.edit'}}">
            <i class="fa-solid fa-pen-to-square"></i>
          </button>
          <button type="button" class="icon" data-action="deleteSubType" data-sub-index="{{@index}}"
                  aria-label="{{localize 'SANDBOX_SETTLEMENT_MANAGER.resourceType.subType.delete'}}">
            <i class="fa-solid fa-trash"></i>
          </button>
        </div>
      </li>
      {{else}}
      <li class="sub-type-empty">
        <em>{{localize "SANDBOX_SETTLEMENT_MANAGER.resourceType.noSubTypes"}}</em>
      </li>
      {{/each}}
    </ul>
    <div class="sub-type-add-row">
      <button type="button" data-action="addSubType">
        <i class="fa-solid fa-plus"></i> {{localize "SANDBOX_SETTLEMENT_MANAGER.resourceType.subType.add"}}
      </button>
    </div>
  </fieldset>
</div>
