<div>
  <div class="form-group">
    <label>{{localize "SANDBOX_SETTLEMENT_MANAGER.settlementType.nameLabel"}}</label>
    <input type="text" name="name" value="{{settlementType.name}}"
           placeholder="{{localize 'SANDBOX_SETTLEMENT_MANAGER.settlementType.namePlaceholder'}}">
  </div>
  <div class="form-group">
    <label>{{localize "SANDBOX_SETTLEMENT_MANAGER.settlementType.maxDenomLabel"}}</label>
    <select name="maxCurrencyId">
      <option value="" {{#if (eq settlementType.maxCurrencyId "")}}selected{{/if}}>
        {{localize "SANDBOX_SETTLEMENT_MANAGER.settlementType.maxDenomDefault"}}
      </option>
      {{#each currencyOptions}}
      <option value="{{this.id}}" {{#if (eq ../settlementType.maxCurrencyId this.id)}}selected{{/if}}>
        {{this.name}} ({{this.abbreviation}})
      </option>
      {{/each}}
      <option value="*" {{#if (eq settlementType.maxCurrencyId "*")}}selected{{/if}}>
        {{localize "SANDBOX_SETTLEMENT_MANAGER.settlementType.maxDenomNoLimit"}}
      </option>
    </select>
  </div>
</div>
