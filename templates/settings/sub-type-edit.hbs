<div class="sub-type-edit-form">
  {{#if showTypeSelect}}
  <div class="template-type-row">
    <label>{{localize "SANDBOX_SETTLEMENT_MANAGER.locationType.typeLabel"}}</label>
    <select name="templateType">
      {{#each coreTypes}}
      <option value="{{this.id}}"{{#if (eq this.id ../selectedType)}} selected{{/if}}>{{this.name}}</option>
      {{/each}}
    </select>
  </div>
  {{/if}}
  <div class="template-name-row">
    <label>{{localize "SANDBOX_SETTLEMENT_MANAGER.locationType.subType.nameLabel"}}</label>
    <input type="text" name="name" value="{{subType.name}}"
           placeholder="{{localize 'SANDBOX_SETTLEMENT_MANAGER.locationType.subType.namePlaceholder'}}"
           class="template-name-input">
  </div>
  {{#if showTypeSpecificSections}}
  <div class="inn-only"{{#unless isInn}} hidden{{/unless}}>
    <fieldset class="lodging-templates">
      <legend>{{localize "SANDBOX_SETTLEMENT_MANAGER.inn.defaultLodgings"}}</legend>
      <table class="lodging-edit-table">
        <thead>
          <tr>
            <th class="col-lname">{{localize "SANDBOX_SETTLEMENT_MANAGER.inn.lodging.name"}}</th>
            <th class="col-num" title="{{localize 'SANDBOX_SETTLEMENT_MANAGER.inn.lodging.availabilityHint'}}">{{localize "SANDBOX_SETTLEMENT_MANAGER.inn.lodging.availability"}}</th>
            <th class="col-num">{{localize "SANDBOX_SETTLEMENT_MANAGER.inn.lodging.beds"}}</th>
            <th class="col-price">cost/day</th>
            <th class="col-auto"><i class="fa-solid fa-link" title="{{localize 'SANDBOX_SETTLEMENT_MANAGER.inn.lodging.autoWeekly'}}"></i></th>
            <th class="col-price">cost/wk</th>
            <th class="col-del"></th>
          </tr>
        </thead>
        <tbody>
          {{#each lodgings}}
          <tr class="lodging-table-row" data-lodging-id="{{this.id}}">
            <td class="col-lname">
              <input type="text" data-field="name" value="{{this.name}}"
                     placeholder="{{localize 'SANDBOX_SETTLEMENT_MANAGER.inn.lodging.name'}}"
                     class="lodging-name-input">
            </td>
            <td class="col-num">
              <input type="number" data-field="availability" value="{{this.availability}}" min="1" step="1"
                     class="lodging-num-input" placeholder="∞"
                     title="{{localize 'SANDBOX_SETTLEMENT_MANAGER.inn.lodging.availabilityHint'}}">
            </td>
            <td class="col-num">
              <input type="number" data-field="beds" value="{{this.beds}}" step="1"
                     class="lodging-num-input">
            </td>
            <td class="col-price">
              {{> ssm-price-input attr="data-field" field="pricePerDay" price=this.pricePerDay currencies=../currencies amountClass="lodging-price-input" selectClass="price-currency-select"}}
            </td>
            <td class="col-auto">
              <input type="checkbox" data-field="autoWeekly" {{#if this.autoWeekly}}checked{{/if}} hidden>
              <button type="button" class="link-toggle-btn{{#if this.autoWeekly}} is-linked{{/if}}"
                      aria-label="{{localize 'SANDBOX_SETTLEMENT_MANAGER.inn.lodging.autoWeekly'}}">
                <i class="fa-solid fa-link"></i>
              </button>
            </td>
            <td class="col-price">
              <input type="number" data-field="pricePerWeekAmount" value="{{this.pricePerWeek.amount}}"
                     min="0" step="0.01" class="lodging-price-input"{{#if this.autoWeekly}} readonly{{/if}}>
              <select data-field="pricePerWeekCurrencyId" class="price-currency-select"{{#if this.autoWeekly}} disabled{{/if}}>
                {{#each ../currencies}}
                <option value="{{this.id}}"{{#if (eq this.id ../pricePerWeek.currencyId)}} selected{{/if}}>{{this.abbreviation}}</option>
                {{/each}}
              </select>
            </td>
            <td class="col-del">
              <button type="button" class="icon" data-action="deleteLodging" data-index="{{@index}}"
                      aria-label="Remove">
                <i class="fa-solid fa-times"></i>
              </button>
            </td>
          </tr>
          {{else}}
          <tr>
            <td colspan="7" class="lodging-table-empty">
              <em>{{localize "SANDBOX_SETTLEMENT_MANAGER.inn.noDefaultLodgings"}}</em>
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
      <button type="button" data-action="addLodging" class="lodging-add-btn">
        <i class="fa-solid fa-plus"></i> {{localize "SANDBOX_SETTLEMENT_MANAGER.inn.lodging.add"}}
      </button>
    </fieldset>

    <fieldset class="menu-courses">
      <legend>{{localize "SANDBOX_SETTLEMENT_MANAGER.inn.menu.defaultMenuLegend"}}</legend>
      {{#each courses}}
      <div class="course-list-row">
        <span class="course-list-name">{{this.name}}</span>
        <span class="course-list-badge{{#if this.isRandom}} badge-random{{else}} badge-static{{/if}}">
          {{#if this.isRandom}}{{localize "SANDBOX_SETTLEMENT_MANAGER.inn.course.modeRandom"}}{{else}}{{localize "SANDBOX_SETTLEMENT_MANAGER.inn.course.modeStatic"}}{{/if}}
        </span>
        <span class="course-list-count">{{this.itemCount}} items</span>
        <div class="course-list-controls">
          <button type="button" class="icon" data-action="editCourse" data-course-index="{{this.index}}"
                  aria-label="{{localize 'SANDBOX_SETTLEMENT_MANAGER.locationType.subType.edit'}}">
            <i class="fa-solid fa-pen-to-square"></i>
          </button>
          <button type="button" class="icon" data-action="deleteCourse" data-course-index="{{this.index}}"
                  aria-label="{{localize 'SANDBOX_SETTLEMENT_MANAGER.locationType.subType.delete'}}">
            <i class="fa-solid fa-trash"></i>
          </button>
        </div>
      </div>
      {{else}}
      <p class="course-list-empty"><em>{{localize "SANDBOX_SETTLEMENT_MANAGER.inn.menu.notConfigured"}}</em></p>
      {{/each}}
      <button type="button" data-action="addCourse" class="course-add-btn">
        <i class="fa-solid fa-plus"></i> {{localize "SANDBOX_SETTLEMENT_MANAGER.inn.course.addTitle"}}
      </button>
      <button type="button" data-action="copyCoursesFromTemplate" class="course-add-btn">
        <i class="fa-solid fa-copy"></i> {{localize "SANDBOX_SETTLEMENT_MANAGER.inn.course.copyFromTemplate"}}
      </button>
      <button type="button" data-action="importFromRollTable" class="course-add-btn">
        <i class="fa-solid fa-table-list"></i> {{localize "SANDBOX_SETTLEMENT_MANAGER.inn.course.importFromTable"}}
      </button>
    </fieldset>
  </div>
  {{#if showBankSection}}
  <div class="bank-only"{{#unless isBank}} hidden{{/unless}}>
    <fieldset class="bank-exchange-config">
      <legend>{{localize "SANDBOX_SETTLEMENT_MANAGER.bank.exchangeSettingsTitle"}} <i class="fa-solid fa-circle-question ssm-help" data-tooltip="{{localize 'SANDBOX_SETTLEMENT_MANAGER.help.bankExchange'}}"></i></legend>
      <div class="form-group bank-checkbox-group">
        <label>{{localize "SANDBOX_SETTLEMENT_MANAGER.bank.doesExchangeLabel"}}</label>
        <input type="checkbox" name="bankDoesExchange"{{#if bankData.doesExchange}} checked{{/if}}>
      </div>
      <div class="form-group">
        <label>{{localize "SANDBOX_SETTLEMENT_MANAGER.bank.exchangeFeeLabel"}}</label>
        <input type="number" name="bankExchangeFee" value="{{bankData.exchangeFee}}" min="0" max="100" step="0.1"
               class="bank-fee-input">
        <span>%</span>
      </div>
    </fieldset>
    <fieldset class="bank-deposit-config">
      <legend>{{localize "SANDBOX_SETTLEMENT_MANAGER.bank.deposits.settingsTitle"}} <i class="fa-solid fa-circle-question ssm-help" data-tooltip="{{localize 'SANDBOX_SETTLEMENT_MANAGER.help.bankDeposits'}}"></i></legend>
      <div class="form-group bank-checkbox-group">
        <label>{{localize "SANDBOX_SETTLEMENT_MANAGER.bank.deposits.globalLabel"}}</label>
        <input type="checkbox" name="bankDepositGlobal"{{#if bankData.depositSettings.global}} checked{{/if}}>
      </div>
      <div class="form-group">
        <label>{{localize "SANDBOX_SETTLEMENT_MANAGER.bank.deposits.depositFeeLabel"}}</label>
        <input type="number" name="bankDepositFee" value="{{bankData.depositSettings.depositFee}}" min="0" max="100" step="0.1"
               class="bank-fee-input">
        <span>%</span>
      </div>
      <div class="form-group">
        <label>{{localize "SANDBOX_SETTLEMENT_MANAGER.bank.deposits.minDepositDaysLabel"}}</label>
        <input type="number" name="bankMinDepositDays" value="{{bankData.depositSettings.minDepositDays}}" min="0" step="1"
               class="bank-fee-input">
        <span>{{localize "SANDBOX_SETTLEMENT_MANAGER.bank.deposits.daysUnit"}}</span>
      </div>
      <div class="form-group">
        <label>{{localize "SANDBOX_SETTLEMENT_MANAGER.bank.deposits.earlyWithdrawalFeeLabel"}}</label>
        <input type="number" name="bankEarlyWithdrawalFee" value="{{bankData.depositSettings.earlyWithdrawalFee}}" min="0" max="100" step="0.1"
               class="bank-fee-input">
        <span>%</span>
      </div>
    </fieldset>
  </div>
  {{/if}}
  {{#if showMerchantSection}}
  <div class="merchant-only"{{#unless isMerchant}} hidden{{/unless}}>
    <nav class="ssm-merchant-tabs">
      <button type="button" data-action="switchMerchantTab" data-tab="inventory"
              class="ssm-merchant-tab-btn{{#if (eq merchantTab 'inventory')}} active{{/if}}">
        {{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.defaultInventoryTab"}}
      </button>
      <button type="button" data-action="switchMerchantTab" data-tab="purchasing"
              class="ssm-merchant-tab-btn{{#if (eq merchantTab 'purchasing')}} active{{/if}}">
        {{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.purchasingProfile"}}
      </button>
    </nav>

    {{#if (eq merchantTab "inventory")}}
    <fieldset class="merchant-inventory-templates">
      <legend>{{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.defaultInventory"}} <i class="fa-solid fa-circle-question ssm-help" data-tooltip="{{localize 'SANDBOX_SETTLEMENT_MANAGER.help.merchantInventory'}}"></i></legend>
      <div class="merchant-stock-config">
        <label>{{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.stockType"}}</label>
        <select name="merchantStockType">
          <option value="percent"{{#if (eq stockType "percent")}} selected{{/if}}>{{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.stockTypePercent"}}</option>
          <option value="x-in-6"{{#if (eq stockType "x-in-6")}} selected{{/if}}>{{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.stockTypeXin6"}}</option>
        </select>
        <label>{{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.restockFrequency"}}</label>
        <select name="merchantRestockFrequency">
          <option value="daily"{{#if (eq restockFrequency "daily")}} selected{{/if}}>{{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.restockDaily"}}</option>
          <option value="weekly"{{#if (eq restockFrequency "weekly")}} selected{{/if}}>{{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.restockWeekly"}}</option>
          <option value="monthly"{{#if (eq restockFrequency "monthly")}} selected{{/if}}>{{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.restockMonthly"}}</option>
        </select>
      </div>
      <div class="merchant-template-drop-zone merchant-drop-zone">
        <i class="fa-solid fa-box-open"></i>
        <span>{{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.dropHint"}}</span>
      </div>
      <table class="merchant-template-table">
        <thead>
          <tr>
            <th class="col-mname">{{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.colItem"}}</th>
            <th class="col-mprice">{{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.colPrice"}}</th>
            <th class="col-msize">{{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.settlementSize"}} <i class="fa-solid fa-circle-question ssm-help" data-tooltip="{{localize 'SANDBOX_SETTLEMENT_MANAGER.help.merchantSettlementSize'}}"></i></th>
            <th class="col-mavail">{{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.stockAvailability"}} <i class="fa-solid fa-circle-question ssm-help" data-tooltip="{{localize 'SANDBOX_SETTLEMENT_MANAGER.help.merchantAvailability'}}"></i></th>
            <th class="col-mformula">{{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.stockFormula"}} <i class="fa-solid fa-circle-question ssm-help" data-tooltip="{{localize 'SANDBOX_SETTLEMENT_MANAGER.help.merchantStockFormula'}}"></i></th>
            <th class="col-del"></th>
          </tr>
        </thead>
        <tbody>
          {{#each templateInventory}}
          <tr class="merchant-inventory-row" data-inventory-item-id="{{this.id}}"
              data-item-uuid="{{this.itemId}}" data-item-type="{{this.itemType}}">
            <td class="col-mname">
              {{#if this.itemId}}
              {{{this.enrichedName}}}
              <input type="hidden" data-field="name" value="{{this.name}}">
              {{else}}
              <input type="text" data-field="name" value="{{this.name}}"
                     placeholder="{{localize 'SANDBOX_SETTLEMENT_MANAGER.merchant.itemNamePlaceholder'}}">
              {{/if}}
            </td>
            <td class="col-mprice">
              {{> ssm-price-input attr="data-field" field="price" price=this.price currencies=../currencies amountClass="lodging-price-input" selectClass="price-currency-select"}}
            </td>
            <td class="col-msize">
              <select data-field="minSettlementSize">
                <option value=""{{#unless this.minSettlementSize}} selected{{/unless}}>{{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.settlementSizeAll"}}</option>
                {{#each ../settlementTypes}}
                <option value="{{this.name}}"{{#if (eq this.name ../minSettlementSize)}} selected{{/if}}>{{this.name}}</option>
                {{/each}}
              </select>
            </td>
            <td class="col-mavail">
              {{#if ../isXInSix}}
              <select data-field="stockAvailability" class="ssm-xin6-select">
                {{#each this.xin6Options}}
                <option value="{{this.value}}"{{#if this.selected}} selected{{/if}}>{{this.label}}</option>
                {{/each}}
              </select>
              {{else}}
              <input type="number" data-field="stockAvailability" value="{{this.stockAvailability}}"
                     min="0" max="100" step="1" class="lodging-num-input">
              {{/if}}
            </td>
            <td class="col-mformula">
              <input type="text" data-field="stockFormula" value="{{this.stockFormula}}"
                     placeholder="{{localize 'SANDBOX_SETTLEMENT_MANAGER.merchant.stockFormulaHint'}}">
            </td>
            <td class="col-del">
              <button type="button" class="icon" data-action="deleteTemplateInventoryItem"
                      data-index="{{@index}}" aria-label="Remove">
                <i class="fa-solid fa-times"></i>
              </button>
            </td>
          </tr>
          {{else}}
          <tr>
            <td colspan="6" class="lodging-table-empty">
              <em>{{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.noDefaultInventory"}}</em>
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
      <div class="merchant-inventory-actions">
        <button type="button" data-action="addTemplateInventoryItem" class="lodging-add-btn">
          <i class="fa-solid fa-plus"></i> {{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.addTemplateItem"}}
        </button>
        <button type="button" data-action="sortInventory" class="lodging-add-btn">
          <i class="fa-solid fa-arrow-down-short-wide"></i> {{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.sortButton"}}
        </button>
      </div>
    </fieldset>
    {{/if}}

    {{#if (eq merchantTab "purchasing")}}
    <fieldset class="purchasing-profile-fieldset">
      <legend>{{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.purchasingProfile"}} <i class="fa-solid fa-circle-question ssm-help" data-tooltip="{{localize 'SANDBOX_SETTLEMENT_MANAGER.help.merchantPurchasing'}}"></i></legend>

      <div class="purchasing-add-row">
        <div class="ssm-rule-field ssm-rule-field-type">
          <label class="ssm-rule-header">{{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.ruleItemTypeHeader"}}</label>
          <select data-field="ruleItemType" class="ssm-rule-type-select">
            <option value="">{{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.settlementSizeAll"}}</option>
            {{#each systemItemTypes}}
            <option value="{{this.value}}">{{this.label}}</option>
            {{/each}}
          </select>
        </div>
        <div class="ssm-rule-field">
          <label class="ssm-rule-header" title="{{localize 'SANDBOX_SETTLEMENT_MANAGER.merchant.merchantPriceHint'}}">{{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.ruleMerchantPriceHeader"}}</label>
          <div class="ssm-rule-rate-wrap">
            <input type="number" data-field="ruleBuyRate" value="50" min="0" max="100" step="1" class="lodging-num-input">
            <span>%</span>
          </div>
        </div>
        <div class="ssm-rule-field">
          <label class="ssm-rule-header">{{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.ruleBuybackHeader"}}</label>
          <select data-field="ruleBuybackType" class="ssm-rule-buyback-select">
            {{#each buybackTypeOptions}}
            <option value="{{this.value}}">{{this.label}}</option>
            {{/each}}
          </select>
        </div>
        <div class="ssm-rule-field ssm-rule-field-action">
          <button type="button" data-action="addPurchasingRule" class="lodging-add-btn">
            <i class="fa-solid fa-plus"></i> {{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.addRule"}}
          </button>
        </div>
      </div>

      <table class="ssm-purchasing-profile-table">
        <thead>
          <tr>
            <th>{{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.colItem"}}</th>
            <th class="col-num">{{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.merchantPrice"}}</th>
            <th>{{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.buybackType"}}</th>
            <th class="col-del"></th>
          </tr>
        </thead>
        <tbody>
          {{#each purchasingProfile}}
          <tr>
            <td>{{#if this.itemType}}{{this.itemType}}{{else}}<em>{{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.settlementSizeAll"}}</em>{{/if}}</td>
            <td class="col-num ssm-col-right">{{this.buyRate}}%</td>
            <td>{{#if (eq this.buybackType "full")}}{{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.buybackFull"}}{{else}}{{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.buybackPlayer"}}{{/if}}</td>
            <td class="col-del">
              <button type="button" class="icon" data-action="removePurchasingRule"
                      data-index="{{@index}}" aria-label="Remove">
                <i class="fa-solid fa-times"></i>
              </button>
            </td>
          </tr>
          {{else}}
          <tr>
            <td colspan="4" class="lodging-table-empty">
              <em>{{localize "SANDBOX_SETTLEMENT_MANAGER.merchant.noRules"}}</em>
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </fieldset>
    {{/if}}
  </div>
  {{/if}}
  {{/if}}
</div>
